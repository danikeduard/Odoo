<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_library" model="ir.module.category">
        <field name="name">Бібліотека</field>
        <field name="sequence">10</field>
    </record>

    <record id="group_privilege_library" model="res.groups.privilege">
        <field name="name">Бібліотека</field>
        <field name="category_id" ref="module_category_library"/>
    </record>

    <record id="group_library_librarian" model="res.groups">
        <field name="name">Бібліотекар</field>
        <field name="privilege_id" ref="group_privilege_library"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="group_library_reader" model="res.groups">
        <field name="name">Читач</field>
        <field name="privilege_id" ref="group_privilege_library"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="rule_library_loan_reader" model="ir.rule">
        <field name="name">Читач бачить лише свої видачі</field>
        <field name="model_id" ref="model_library_loan"/>
        <field name="domain_force">['|', ('member_id.user_id', '=', user.id), ('member_id.partner_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('group_library_reader'))]"/>
    </record>

    <record id="rule_library_loan_librarian" model="ir.rule">
        <field name="name">Бібліотекар бачить усі видачі</field>
        <field name="model_id" ref="model_library_loan"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_library_librarian'))]"/>
    </record>
</odoo>
