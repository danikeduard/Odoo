<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="demo_book_1" model="library.book">
            <field name="name">Кобзар</field>
            <field name="author">Тарас Шевченко</field>
            <field name="publish_year">1840</field>
        </record>
        <record id="demo_book_2" model="library.book">
            <field name="name">Лісова пісня</field>
            <field name="author">Леся Українка</field>
            <field name="publish_year">1911</field>
        </record>
        <record id="demo_book_3" model="library.book">
            <field name="name">1984</field>
            <field name="author">Джордж Орвелл</field>
