        <record id="demo_loan_1" model="library.loan">
            <field name="copy_id" ref="demo_copy_1"/>
            <field name="member_id" ref="demo_member_1"/>
            <field name="loan_date" eval="(DateTime.today() - timedelta(days=30)).strftime('%Y-%m-%d')"/>
        </record>
        <function model="library.loan" name="write">
            <value eval="[ref('demo_loan_1')]"/>
            <value eval="{'return_date': (DateTime.today() - timedelta(days=20)).strftime('%Y-%m-%d')}"/>
        </function>
        <record id="demo_loan_2" model="library.loan">
            <field name="copy_id" ref="demo_copy_2"/>
            <field name="member_id" ref="demo_member_1"/>
