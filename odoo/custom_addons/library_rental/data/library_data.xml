        </record>
        <record id="demo_copy_2" model="library.copy">
            <field name="name">LIB-002</field>
            <field name="book_id" ref="demo_book_2"/>
            <field name="state">available</field>
        </record>
        <record id="demo_copy_3" model="library.copy">
            <field name="name">LIB-003</field>
            <field name="book_id" ref="demo_book_3"/>
            <field name="state">available</field>
        </record>
        <record id="demo_copy_4" model="library.copy">
            <field name="name">LIB-004</field>
            <field name="book_id" ref="demo_book_4"/>
            <field name="state">available</field>
        </record>
        <record id="demo_copy_5" model="library.copy">
            <field name="name">LIB-005</field>
